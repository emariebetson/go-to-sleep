    "live_bindings": ["DB", "AUDIO", "VERSION_METADATA", "GOOGLE_CLIENT_ID", "BETTER_AUTH_URL", "PUBLIC_APP_URL"],
    "version_metadata_tag": "release.commitSha",
    "default_dark_bindings": ["NEARYOU_ENABLE_STORY", "NEARYOU_ENABLE_LEGACY_ARCHIVE", "PRIVATE_TESTER_SCHEDULER_ENABLED"],
    "release_binding": "PRIVATE_TESTER_BASELINE_RELEASE_JSON",
