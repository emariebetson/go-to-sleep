{
  "required_worker_bindings": {
    "vars": [
      "EVIDENCE_COLLECTION_APPROVED",
      "OUTCOME_RUNTIME",
      "OUTCOME_ENDPOINT",
      "OUTCOME_AUDIENCE",
      "OUTCOME_WIF_AUDIENCE",
