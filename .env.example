# Never commit real secret values. Copy this file to .env.local for development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional public ElevenLabs default voice ID used only for clearly labeled demo narration.
ELEVENLABS_DEMO_VOICE_ID=cgSgspJ2msm6clMCkdW9
# Keep false or unset outside private testing.
NEARNIGHT_ENABLE_DEMO_NARRATOR=false
# Versioned NearYou API is on by default; future product modules remain gated.
NEARYOU_ENABLE_FOUNDATION_API=false
NEARYOU_ENABLE_STORY=false
NEARYOU_ENABLE_LEGACY_ARCHIVE=false
NEARYOU_ENABLE_ASYNC_MEDIA_JOBS=false
NEARYOU_ENABLE_USAGE_RESERVATIONS=false
NEARYOU_REQUIRE_VERIFIED_VOICE_CONSENT=false
# Task 2A verification/reservation foundation. Keep false: live route/UI/billing wiring ships in Task 2B.
NEARYOU_ENABLE_PRODUCTION_UPGRADE_FOUNDATION=false
# Task 2B live integration. Enable only with 0006-0011 applied, duplicate-live-voice preflight clear, onboarding UX live, and verified-consent enforcement enabled.
NEARYOU_ENABLE_NEARSLEEP_PRODUCTION=false
NEARYOU_ENABLE_NEARSLEEP_LIBRARY_PRIVACY=false
# Enable only after 0012 is applied, to run the dark storage backfill before the product flag.
NEARYOU_ENABLE_NEARSLEEP_LIBRARY_RECONCILIATION=false
NEARYOU_RECONCILIATION_SECRET=
# Safety holds are enforced in code even if these are accidentally set true.
NEARYOU_ENABLE_CHILD_MICROPHONE=false
NEARYOU_ENABLE_POSTHUMOUS_SYNTHESIS=false
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_NEARYOU_PLUS_MONTHLY=
STRIPE_PRICE_NEARYOU_PLUS_ANNUAL=
STRIPE_PRICE_NEARYOU_FAMILY_MONTHLY=
STRIPE_PRICE_NEARYOU_FAMILY_ANNUAL=
# Kept unselectable while NEARYOU_ENABLE_LEGACY_ARCHIVE is false.
STRIPE_PRICE_NEARLEGACY_MONTHLY=
STRIPE_PRICE_NEARLEGACY_ANNUAL=
# Prevent the private preview from ever accepting a live Stripe secret.
STRIPE_TEST_MODE_ONLY=true
ADMIN_EMAILS=
PUBLIC_APP_URL=http://localhost:3000
# NearStory remains fail-closed until all flags, migration readiness, fresh worker heartbeat,
# provider credentials, and the private FFmpeg media worker are configured.
NEARYOU_MEDIA_WORKER_URL=
NEARYOU_MEDIA_WORKER_SECRET=
NEARYOU_STORY_WORKER_SECRET=
NEARYOU_ENABLE_STORY_BRANCHING=false
