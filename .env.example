# Never commit real secret values. Copy this file to .env.local for development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional public ElevenLabs default voice ID used only for clearly labeled demo narration.
ELEVENLABS_DEMO_VOICE_ID=cgSgspJ2msm6clMCkdW9
# Keep false or unset outside private testing.
NEARNIGHT_ENABLE_DEMO_NARRATOR=false
# Versioned NearYou API is on by default; future product modules remain gated.
NEARYOU_ENABLE_FOUNDATION_API=false
NEARYOU_ENABLE_STORY=false
NEARYOU_ENABLE_LEGACY_ARCHIVE=false
NEARYOU_ENABLE_ASYNC_MEDIA_JOBS=false
NEARYOU_ENABLE_USAGE_RESERVATIONS=false
NEARYOU_REQUIRE_VERIFIED_VOICE_CONSENT=false
# Safety holds are enforced in code even if these are accidentally set true.
NEARYOU_ENABLE_CHILD_MICROPHONE=false
NEARYOU_ENABLE_POSTHUMOUS_SYNTHESIS=false
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
# Prevent the private preview from ever accepting a live Stripe secret.
STRIPE_TEST_MODE_ONLY=true
ADMIN_EMAILS=
PUBLIC_APP_URL=http://localhost:3000
